{
  "project": "ONE MORE TILE",
  "version": "3.0.0-PROD",
  "phase": "Phase 3 Architecture Specification (Levels 11–15)",
  "target_platform": "YouTube Playables (HTML5 Canvas / WebAudio)",
  "budget_bytes": 307200,
  "system_axioms": {
    "discrete_state_sovereignty": "The logical board state is an immutable integer lattice updated instantaneously on discrete ticks.",
    "permanent_space_consumption": "Ordinary traversable tiles exit-mutate to CONSUMED_HISTORY. Crumbling tiles exit-mutate to VOID.",
    "strict_orthogonality": "All movement, adjacency, pathing, and connectivity checks are strictly Manhattan L1 metric. Diagonals prohibited.",
    "zero_margin_budget": "For Phase 3, initial Spatial Budget B0 equals exact optimal move count L_opt. Final budget at Goal entry must equal exactly 0.",
    "reachability_dominance": "Topological reachability strictly dominates objective satisfaction. g in C_player takes precedence."
  },
  "mechanic_crumbling_tile": {
    "cell_enum": {
      "id": 7,
      "name": "CRUMBLING_TILE",
      "identifier": "C_CRUMBLING",
      "traversal_cost": 1,
      "initial_passability": true
    },
    "state_transition_lifecycle": {
      "on_enter": "Player occupies the crumbling tile. Logical position snaps instantaneously; tile enters active vibration state.",
      "on_exit": "Departure from C_CRUMBLING bypasses C_CONSUMED and mutates directly to C_VOID = 0. The substrate plate and metadata conduit vectors are obliterated.",
      "post_exit_state": "C_VOID (Absolute impassable chasm; grid[y][x] = 0; traversal cost = infinity). Attempting to re-enter is strictly rejected with a wall deflection thump."
    },
    "webaudio_synthesis": {
      "function_name": "playTileCrumble",
      "synthesis_profile": {
        "sub_bass_rumble": {
          "oscillator_type": "triangle",
          "start_frequency_hz": 95,
          "end_frequency_hz": 30,
          "duration_sec": 0.18,
          "gain_peak": 0.38
        },
        "brittle_snap": {
          "oscillator_type": "sawtooth",
          "start_frequency_hz": 1850,
          "end_frequency_hz": 850,
          "duration_sec": 0.08,
          "gain_peak": 0.22
        }
      }
    },
    "canvas_rendering_pipeline": {
      "base_color": "#252836",
      "border_color": "#ff9933",
      "border_width_px": 1.5,
      "fissure_decals": {
        "stroke_style": "rgba(255, 153, 51, 0.75)",
        "line_width_px": 1.5,
        "crack_points_normalized": [
          [0.15, 0.2],
          [0.45, 0.5],
          [0.55, 0.4],
          [0.85, 0.8]
        ]
      },
      "occupied_vibration": {
        "amplitude_px": 1.2,
        "frequency_hz": 24.0
      },
      "collapse_particle_burst": {
        "color": "#4a5568",
        "particle_count": 14,
        "radius_min": 2,
        "radius_max": 4,
        "decay_rate": 0.035
      }
    },
    "bi_directional_undo": {
      "rule": "BiDirectionalStateFrame stores prevCellState = C_CRUMBLING. Upon undoing a move away from a collapsed crumbling tile, grid[y][x] is restored directly to C_CRUMBLING (7) in O(1) time without state drift."
    }
  },
  "difficulty_and_retention_architecture": {
    "target_platform_loop": "YouTube Playables micro-session 'rage-replay' loop. Frictionless instant restart (<16ms) coupled with ruthless spatial precision.",
    "zero_margin_policy": {
      "rule": "B0 = L_opt across Levels 11 through 15",
      "goal_entry_budget": "Bt_final == 0",
      "deadlock_trigger": "Taking any single extraneous move decrements budget to Bt = -1, instantly triggering hard deadlock, extinguishing the Goal flame, shaking the screen, and displaying the retry banner."
    },
    "psychological_misdirection_archetypes": [
      {
        "name": "The Greedy Snare",
        "mechanism": "Spawn placed adjacent to a direct, visible corridor to C1. Stepping into C1 consumes the only articulation cut-vertex, permanently severing access to C2 or stranding the player."
      },
      {
        "name": "The Double Cross",
        "mechanism": "Intersecting paths crossing a central hub tile. Traversing the hub on the outbound leg destroys the bridge for the return leg."
      },
      {
        "name": "The One-Way Chasm Bridge",
        "mechanism": "Fragile span across absolute void. The moment the player steps off onto an island, the bridge evaporates into void, forbidding any retreat."
      },
      {
        "name": "The False Haven",
        "mechanism": "An apparent safe side-pocket or shortcut. Stepping into it collapses a crumbling tile, isolating the player in a dead-end pocket."
      }
    ]
  },
