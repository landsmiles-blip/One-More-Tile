{
  "project": "ONE MORE TILE",
  "version": "5.0.0-REDESIGN",
  "title": "Complete 20-Level Redesign Specification (Anti-Corridor Architecture)",
  "platform": "YouTube Playables (HTML5 Canvas / WebAudio, <300KB Budget)",
  "design_directives": {
    "anti_corridor_mandate": "Abolish 1-tile-wide linear corridors. Every level is an open arena (4x3 to 7x7) with central obstacles, providing 2 to 3 branching choices at almost every step.",
    "delayed_consequence": "Greedy turns on early steps create unreachable orphan tiles or sever the board on late steps.",
    "bipartite_parity_invariance": "All Hamiltonian paths satisfy the Bipartite Graph Parity Theorem: |Count(Even) - Count(Odd)| <= 1, with path endpoints strictly matching move count parity."
  },
  "mechanic_specifications": {
    "C_CROSSROAD": {
      "id": 11,
      "name": "DUAL_PASS_CROSSROAD",
      "identifier": "C_CROSSROAD",
      "initial_visits": 2,
      "traversal_cost": 1,
      "passability_rule": "Passable iff visitsRemaining > 0",
      "departure_lifecycle": "On visit 1 exit: visitsRemaining = 1, glows amber, remains traversable. On visit 2 exit: visitsRemaining = 0, mutates to C_CONSUMED.",
      "undo_contract": "Losslessly restores visitsRemaining from 0->1 or 1->2 in O(1)."
    },
    "C_ICE": {
      "id": 12,
      "name": "FRICTIONLESS_ICE",
      "identifier": "C_ICE",
      "momentum_rule": "Continuous momentum sliding in input direction until hitting an obstacle (Wall, Boundary, Consumed Tile) or landing on a non-ice traversable tile.",
      "trail_bumper_axiom": "Traversed and departed ice tiles mutate to C_CONSUMED, dynamically constructing artificial bumpers for subsequent orthogonal slides.",
      "move_cost": "Entire slide sequence consumes exactly 1 move (decrements budget by 1).",
      "undo_contract": "Single undo frame restores player to pre-slide coordinates and resurrects all traversed ice tiles in O(1)."
    }
  },
  "worlds": [
    {
      "world": 1,
      "title": "Open Weaves & Parity Traps",
      "levels": [1, 2, 3, 4, 5],
      "theme": "Open arenas (4x3 to 5x5) with central pillars. Hamiltonian path coverage puzzles with high branching factors."
    },
    {
      "world": 2,
      "title": "Knot Theory & Crossroads",
      "levels": [6, 7, 8, 9, 10],
      "theme": "Figure-8s, twin hubs, and intersecting loops using C_CROSSROAD (11)."
    },
    {
      "world": 3,
      "title": "The Frozen Labyrinth",
      "levels": [11, 12, 13, 14, 15],
      "theme": "Momentum sliding and intentional Trail-Bumper construction using C_ICE (12)."
    },
    {
      "world": 4,
